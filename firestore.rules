rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isEditor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor';
    }

  	match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        (isSignedIn() && (resource.data.role == 'admin' || resource.data.role == 'editor'));
      allow list: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      // Owners can edit their own profile (name/phone/address/etc), but
      // NOT role, active, or outletId — those are privilege-sensitive
      // fields that only an admin may set. Without this, any outlet or
      // editor account could self-promote to admin, or reverse their own
      // deactivation, by writing directly to their own user doc.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.get('role', null) == resource.data.get('role', null) &&
          request.resource.data.get('active', null) == resource.data.get('active', null) &&
          request.resource.data.get('outletId', null) == resource.data.get('outletId', null));
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isEditor());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isEditor();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /uoms/{uomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /chats/{outletUid} {
      allow read, write: if isOwner(outletUid) || isAdmin();
      match /messages/{msgId} {
        allow read, create: if isOwner(outletUid) || isAdmin();
      }
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.userId != request.auth.uid;
    }
  }
}